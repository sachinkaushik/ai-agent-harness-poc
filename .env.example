# OpenAI model used by the harness (provider:model).
HARNESS_MODEL=openai:gpt-5.4
OPENAI_API_KEY=
# Optional: model for the quote-reviewer subagent; defaults to HARNESS_MODEL.
HARNESS_SPECIALIST_MODEL=
# Optional: OpenAI-compatible base URL (proxy / Azure gateway). Leave empty for api.openai.com.
OPENAI_BASE_URL=
# Web UI
HARNESS_STAGE=persistence
HARNESS_PORT=8502
LANGSMITH_TRACING=false
